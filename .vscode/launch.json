{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: rodar API (SGI-JMC.Api)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "API: build",
      "program": "${workspaceFolder}/api/SGI-JMC.Api/bin/Debug/net8.0/SGI-JMC.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/api/SGI-JMC.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
    }
  ]
}
